{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Regex",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-guard.sh",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(php -l app/Http/Controllers/Admin/TodoItemController.php)",
      "Bash(php -l app/Models/TodoItem.php)"
    ]
  }
}
