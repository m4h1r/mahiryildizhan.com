{
  "permissions": {
    "allow": [
      "Bash(php -l app/Http/Controllers/Admin/TodoItemController.php)",
      "Bash(php -l app/Models/TodoItem.php)",
      "Bash(node --check resources/js/app.js)",
      "Bash(echo \"exit code: $?\")"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-restore.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-subagent.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
